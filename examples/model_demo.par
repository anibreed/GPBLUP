# GPBLUP demo parameter file (pipeline-native format)
# Two-trait animal model, single-step (H) genomic kernel, APY engine.

[DATA]
PHENOTYPE:    phen.txt
PHENO_HEADER: 1
PHENO_DELIM:  SPACE
PEDIGREE:     ped.txt
GENOTYPE:     geno.txt

[TRAITS]
N_TRAIT: 2
OBS_COL: 5 6
MISSING: -999
NAMES:   ADG  BF

[MODEL]
# EFFECT = name  col  TYPE(FIXED|COV|RANDOM)  traits...  [STRUCT=...]
EFFECT = herd_year  3  FIXED   1 2
EFFECT = sex        4  FIXED   1 2
EFFECT = age        7  COV     1 2
EFFECT = animal     1  RANDOM  1 2  STRUCT=ANIMAL_H
EFFECT = litter     8  RANDOM  1    STRUCT=IID

[VARIANCES]
GENETIC  = 12.0 3.0 ; 3.0 9.0
RESIDUAL = 30.0 5.0 ; 5.0 25.0

[GENOMIC]
KERNEL:      H
ENGINE:      APY
APY_CORE:    4000
POLYGENIC_W: 0.05

[INFERENCE]
METHOD:   REML_AI
MAX_ITER: 100
CONV_TOL: 1e-10
